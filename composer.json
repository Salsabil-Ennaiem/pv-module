{
    "name": "salsabil-ennaiem/pv-module",
    "description": "Module autonome de gestion de Procès-Verbaux signés numériquement (workflow brouillon → en_attente → valide, génération PDF via templates, signatures, notifications, versioning).",
    "keywords": ["laravel", "pv", "proces-verbal", "signature", "pdf", "workflow"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Salsabil Ennaiem",
            "email": "salsabilnaim15@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/translation": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/mail": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/validation": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/bus": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "mpdf/mpdf": "^8.3"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "SalsabilEnnaiem\\PvModule\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SalsabilEnnaiem\\PvModule\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SalsabilEnnaiem\\PvModule\\PvModuleServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}